  assert.equal(getDemoOrders()[0].id, order.id);
  assert.equal(getDemoOrders()[0].total, 49.19);
  assert.equal(getDemoOrders()[0].status, "Simulated order placed");
  delete globalThis.window;
  delete globalThis.localStorage;
});
