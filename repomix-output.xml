<file path="scripts/check-fake-store-api.mjs">
const baseUrl = process.env.NEXT_PUBLIC_API_URL || "https://fakestoreapi.com";
const endpoints = [
  "/products",
  "/products/1",
  "/products/categories",
  "/products/category/electronics",
];
let failed = false;

for (const endpoint of endpoints) {
  const url = new URL(endpoint, baseUrl);
  try {
    const response = await fetch(url, {
      headers: { Accept: "application/json" },
      signal: AbortSignal.timeout(10_000),
    });
    const contentType = response.headers.get("content-type") || "unknown";
    const challenge = response.headers.get("cf-mitigated") === "challenge";
    console.log(
      `${response.status} ${url} (${contentType}${challenge ? ", Cloudflare challenge" : ""})`,
    );
    if (!response.ok || !contentType.includes("json")) failed = true;
    if (response.ok && contentType.includes("json")) {
      const data = await response.json();
      console.log(
        `  JSON: ${Array.isArray(data) ? `${data.length} items` : "object"}`,
      );
    }
  } catch (error) {
    failed = true;
    console.error(
      `${url}: ${error instanceof Error ? error.message : String(error)}`,
    );
  }
}

if (failed) process.exitCode = 1;
</file>

<file path="services/catalog-error.ts">
import axios from "axios";

export class CatalogRequestError extends Error {
  readonly status: number | undefined;
  readonly challenged: boolean;

  constructor(status: number | undefined, challenged: boolean) {
    super(
      challenged
        ? "Fake Store API requires a browser challenge for this server request."
        : status
          ? `Fake Store API returned HTTP ${status}.`
          : "Fake Store API could not be reached.",
    );
    this.name = "CatalogRequestError";
    this.status = status;
    this.challenged = challenged;
  }
}

export function normalizeCatalogError(error: unknown): never {
  if (axios.isAxiosError(error)) {
    throw new CatalogRequestError(
      error.response?.status,
      error.response?.headers?.["cf-mitigated"] === "challenge",
    );
  }
  throw error;
}
</file>

